<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#092128"
                android:startColor="#16444E" />
            <stroke
                android:width="1dp"
                android:color="#2C6B73" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:drawable="@drawable/ic_drop_small"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp" />
</layer-list>
