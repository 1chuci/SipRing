<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sipBg">

    <com.sipring.app.AuroraView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="24dp"
            android:paddingEnd="26dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:text="@string/reminder_brand"
                android:textColor="?attr/sipAccentText"
                android:textSize="10sp" />

            <com.sipring.app.PulseView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/reminder_title"
                android:textColor="?attr/sipTextPrimary"
                android:textSize="40sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/reminder_subtitle"
                android:textColor="?attr/sipTextSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvReminderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="?attr/sipTextFaint"
                android:textSize="10.5sp" />

            <Button
                android:id="@+id/btnDrank"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/reminder_drank"
                android:textAllCaps="false"
                android:textColor="?attr/sipChipTextSelected"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSnooze"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_outline"
                android:backgroundTint="@null"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/reminder_snooze"
                android:textAllCaps="false"
                android:textColor="?attr/sipTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/reminder_pause"
                android:textColor="?attr/sipTextFaint"
                android:textSize="10.5sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
